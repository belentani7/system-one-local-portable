# Default: fully offline, deterministic, no external service required
DECISION_BACKEND=offline

# Optional external scorer. Use any OpenAI-compatible /chat/completions endpoint.
# DECISION_BACKEND=openai-compatible
# DECISION_MODEL_URL=http://localhost:11434/v1/chat/completions
# DECISION_MODEL_NAME=local-model
# DECISION_MODEL_API_KEY=
# DECISION_MODEL_TIMEOUT_MS=30000

# Optional application settings
PORT=3000

# The offline provider is intentionally deterministic and auditable.
# It is not conscious and does not contain a universal model of reality.
